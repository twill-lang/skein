mode systems

# encoding.tw: the output of a tokeniser, and the only place offsets are
# computed.
#
# THE BUG THIS FILE EXISTS TO NOT SHIP
#
# An offset that points into the normalised string instead of the source.
#
# It is the default outcome of every reasonable-looking implementation. You
# normalise, you tokenise the normalised string, and the tokeniser naturally
# reports positions in the string it was given. Those positions are correct
# against a string the user has never seen. On ASCII input with no whitespace
# runs the two strings are identical and every test passes. The moment the input
# has a run of spaces, a control character, an accented letter or an uppercase
# sharp s, the two strings differ in length and every offset after that point is
# wrong by an amount that grows through the document. Nothing errors. The
# highlight is one character off at the top of the page and four words off at
# the bottom, and it gets reported as a rendering bug.
#
# skein's answer is structural, not a matter of care:
#
#   1. A model returns `Pieces`, whose spans are explicitly named `nstarts` and
#      `nends` and are explicitly normalised-text offsets. A model never sees
#      the source string and cannot produce a source offset at all.
#   2. This file, in `from_pieces`, is the only code in the package that calls
#      `normalize.map_span`, and it is the only code that writes `starts` and
#      `ends` on an `Encoding`.
#   3. Everything downstream (specials, truncation, padding, windowing) moves
#      spans around and never computes one.
#
# So the review question "is this offset in the right coordinate system" has one
# place to look, and a wrong answer anywhere else is impossible rather than
# unlikely.
#
# SPECIAL TOKENS HAVE EMPTY SPANS
#
# `[CLS]`, `[SEP]` and `[PAD]` came from nowhere in the source. Their span is
# `(-1, -1)` and not `(0, 0)`.
#
# `(0, 0)` is the common choice and it is wrong in a way that is worse than
# useless: it is a valid offset. A caller mapping tokens back to text gets a
# zero-width span at the very start of the document for every special token, and
# a caller computing "which source characters did the model attend to" sums a
# contribution at offset 0 that came from a token with no source at all. -1
# cannot be dereferenced by accident: it is out of range for every string, so
# the first attempt to use it as an offset fails visibly.

import "std/text" as text
import "../src/normalize.tw" as normalize
import "../src/vocab.tw" as vocab
import "../src/pieces.tw" as pieces

# Seven parallel arrays, all of the same length, which is the sequence length.
#
# Parallel arrays rather than an array of per-token structs, because every
# consumer wants a column: `std/nn`'s embedding wants the ids and nothing else,
# an attention implementation wants the mask and nothing else. An array of
# structs would need a gather per column at every boundary. `assert_shape`
# checks the lengths agree, and is called by every constructor here.
#
#   ids        the vocabulary id, a row index into the embedding table
#   tokens     the token string, for reading and for debugging
#   mask       1 for a real token, 0 for padding
#   type_ids   0 for the first sequence, 1 for the second in a pair
#   starts     byte offset into the ORIGINAL source, or -1
#   ends       byte offset into the ORIGINAL source, exclusive, or -1
#   special    true for a token the tokeniser added rather than found
#
# The dtype each column becomes at the tensor boundary, using the language's
# dtype set (twill docs/dtypes.md), because the consumer builds the tensor and
# building it at the right width beats building it at f64 and narrowing after:
#
#   ids, type_ids   i32. They are row indices into an embedding table and into a
#                   two-row type table, and an index dtype is i32 in twill the
#                   same as argmax's output is. A vocabulary far larger than any
#                   real one still fits 2^31, so i32 is not a constraint.
#   mask            bool. It is a per-token 1-or-0 that an attention layer reads
#                   for truthiness, exactly the dtype every comparison produces.
#   starts, ends    i32 offsets, for a consumer that tensorises them at all;
#                   most read them as a plain array for span mapping and never do.
#
# These are held as Arr[I64] here because the systems subset has no narrower
# array yet (twill NEEDS-111); the dtype is the width the model should build,
# not the width skein stores. A warp pipeline over token ids declares it with
# `pipe.astype(p, dt.DT_I32)`, and the mask column with DT_BOOL.
struct Encoding {
  ids: Arr[I64],
  tokens: Arr[Str],
  mask: Arr[I64],
  type_ids: Arr[I64],
  starts: Arr[I64],
  ends: Arr[I64],
  special: Arr[Bool],
}

fn new_encoding() -> Encoding {
  let a: Arr[I64] = []
  let b: Arr[Str] = []
  let c: Arr[I64] = []
  let d: Arr[I64] = []
  let e: Arr[I64] = []
  let f: Arr[I64] = []
  let g: Arr[Bool] = []
  Encoding { ids: a, tokens: b, mask: c, type_ids: d, starts: e, ends: f, special: g }
}

fn length(e: Encoding) -> I64 = len(e.ids)

fn push_token(e: Encoding, id: I64, tok: Str, mask: I64, type_id: I64,
              start: I64, stop: I64, is_special: Bool) {
  push(e.ids, id)
  push(e.tokens, tok)
  push(e.mask, mask)
  push(e.type_ids, type_id)
  push(e.starts, start)
  push(e.ends, stop)
  push(e.special, is_special)
}

fn copy_token(dst: Encoding, src: Encoding, i: I64) {
  push_token(dst, src.ids[i], src.tokens[i], src.mask[i], src.type_ids[i],
             src.starts[i], src.ends[i], src.special[i])
}

# The invariant every function here maintains. Cheap, and it catches the one
# class of bug a parallel-array representation has.
fn assert_shape(e: Encoding) -> Res[Unit, Str] {
  let n: I64 = len(e.ids)
  if len(e.tokens) != n or len(e.mask) != n or len(e.type_ids) != n
     or len(e.starts) != n or len(e.ends) != n or len(e.special) != n {
    return Err("encoding: the parallel arrays have different lengths, which means a token was appended to some of them and not all")
  }
  Ok(unit)
}

# ---- the special token registry ---------------------------------------------

# The five tokens every model in practice needs, plus an open list.
#
# Named fields for the five rather than only a dictionary, because they are used
# by name in every function in this file and a lookup by string in a padding
# loop is both slow and a place to misspell a key. `extra` exists so a caller
# with a sixth (a language tag, a role marker) can register it and have
# `is_special_id` answer correctly, which is what truncation and offset
# reporting need.
#
# `None` means the token is not configured. Padding without a `[PAD]` is
# refused rather than defaulted to id 0, because id 0 is a real token in a
# vocabulary that did not reserve one, and padding a batch with the word "the"
# is a bug that trains.
#
# These were -1 until 1.6, and unlike the `starts` and `ends` columns above
# there is nothing here that has to survive into a tensor, so the sentinel had
# no job the type cannot do. It also had a hazard: `is_special_id` needed an
# `if id < 0` guard at the top for no reason other than that an unconfigured
# special held -1 and would have matched a caller asking about id -1. With
# `Opt` there is no id to collide with, and the guard is gone.
struct Specials {
  cls: Str,
  sep: Str,
  pad: Str,
  unk: Str,
  msk: Str,
  cls_id: Opt[I64],
  sep_id: Opt[I64],
  pad_id: Opt[I64],
  unk_id: Opt[I64],
  msk_id: Opt[I64],
  extra: Arr[I64],
}

fn no_specials() -> Specials {
  let x: Arr[I64] = []
  Specials { cls: "", sep: "", pad: "", unk: "", msk: "",
             cls_id: None, sep_id: None, pad_id: None, unk_id: None, msk_id: None,
             extra: x }
}

# `Some(id)` when this configured special has that id. `None` matches nothing,
# which is the whole reason the field is an `Opt`.
fn opt_is(o: Opt[I64], id: I64) -> Bool {
  match o {
    Some(x) => x == id,
    None => false,
  }
}

fn opt_count(o: Opt[I64], n: I64) -> I64 {
  match o {
    Some(_) => n,
    None => 0,
  }
}

# The conventional five. Any of the names may be empty, meaning "this model does
# not have one", and an empty name gives an id of -1 rather than an error.
fn bert_specials() -> Arr[Str] {
  let a: Arr[Str] = ["[PAD]", "[UNK]", "[CLS]", "[SEP]", "[MASK]"]
  a
}

fn lookup(v: vocab.Vocab, tok: Str) -> Opt[I64] {
  if len(tok) == 0 {
    return None
  }
  vocab.id_of(v, tok)
}

# Resolve the names against a vocabulary.
#
# Every named token that is not in the vocabulary is an error, and the message
# names it. The alternative, resolving what it can and leaving the rest at -1,
# defers the failure to the first batch that needs padding, which is typically
# in a training loop at three in the morning.
fn specials_from(v: vocab.Vocab, cls: Str, sep: Str, pad: Str, unk: Str,
                 msk: Str) -> Res[Specials, Str] {
  let names: Arr[Str] = [cls, sep, pad, unk, msk]
  let i: I64 = 0
  while i < len(names) {
    if len(names[i]) > 0 {
      match vocab.id_of(v, names[i]) {
        Some(_) => unit,
        None => return Err("encoding.specials_from: '" + names[i] + "' is not in the vocabulary"),
      }
    }
    i = i + 1
  }
  let x: Arr[I64] = []
  Ok(Specials {
    cls: cls, sep: sep, pad: pad, unk: unk, msk: msk,
    cls_id: lookup(v, cls), sep_id: lookup(v, sep), pad_id: lookup(v, pad),
    unk_id: lookup(v, unk), msk_id: lookup(v, msk),
    extra: x,
  })
}

fn register_extra(sp: Specials, v: vocab.Vocab, tok: Str) -> Res[Unit, Str] {
  match vocab.id_of(v, tok) {
    Some(id) => push(sp.extra, id),
    None => return Err("encoding.register_extra: '" + tok + "' is not in the vocabulary"),
  }
  Ok(unit)
}

fn is_special_id(sp: Specials, id: I64) -> Bool {
  if opt_is(sp.cls_id, id) or opt_is(sp.sep_id, id) or opt_is(sp.pad_id, id)
     or opt_is(sp.unk_id, id) or opt_is(sp.msk_id, id) {
    return true
  }
  let i: I64 = 0
  while i < len(sp.extra) {
    if sp.extra[i] == id {
      return true
    }
    i = i + 1
  }
  false
}

# How many tokens the specials will occupy, so truncation can subtract it.
#
# `[UNK]` and `[MASK]` are not counted: they replace a real token rather than
# being added around one. Counting them is the commonest way a max length is
# quietly exceeded by two.
fn overhead_single(sp: Specials) -> I64 =
  opt_count(sp.cls_id, 1) + opt_count(sp.sep_id, 1)

# `[CLS] a [SEP] b [SEP]`: one more separator than the single case.
fn overhead_pair(sp: Specials) -> I64 =
  opt_count(sp.cls_id, 1) + opt_count(sp.sep_id, 2)

# ---- from pieces to an encoding ---------------------------------------------

# THE ONLY PLACE A SOURCE OFFSET IS COMPUTED.
#
# `p` carries spans in the normalised text; `n` carries the trace back to the
# source. Every token's source span is `normalize.map_span` of its normalised
# span, and nothing else in the package calls that function.
#
# A piece whose normalised span is empty gets an empty source span. That happens
# for a model that emits a token with no text behind it, which none of skein's
# do today, and refusing it here would make adding one a change to this file
# rather than to the model.
fn from_pieces(n: normalize.Norm, p: pieces.Pieces, v: vocab.Vocab,
               type_id: I64) -> Encoding {
  let e: Encoding = new_encoding()
  let i: I64 = 0
  while i < len(p.toks) {
    let sp: normalize.Span = normalize.map_span(n, p.nstarts[i], p.nends[i])
    push_token(e, vocab.id_or_unk(v, p.toks[i]), p.toks[i], 1, type_id,
               sp.start, sp.end, false)
    i = i + 1
  }
  e
}

# Drop a leading whitespace byte from a token's source span.
#
# For byte-level BPE with `space_prefix` on, where the first piece of a word
# legitimately includes the space before it (see `src/bpe.tw`). A caller
# rendering a highlight usually wants the word without the space; a caller
# reconstructing the exact input does not. So this is a function the caller
# calls and not something the encoder does, and it needs the source string
# because the space is a byte of the source, not of the token.
fn trim_leading_space(e: Encoding, source: Str) {
  let i: I64 = 0
  while i < length(e) {
    let a: I64 = e.starts[i]
    if a >= 0 and a + 1 < e.ends[i] and a < len(source) and text.is_space(source[a]) {
      e.starts[i] = a + 1
    }
    i = i + 1
  }
}

# ---- truncation --------------------------------------------------------------

# The three truncation strategies.
#
# The case names keep their `Trunc` prefix rather than being `Right`, `Left` and
# `LongestFirst`. `Pad` below has a `Right` and a `Left` too, and two enums in
# scope sharing a case name is exactly the ambiguity the qualified form exists
# for; prefixing here means no call site ever has to write the qualifier, and a
# `TruncRight` handed to a padding argument is a type error rather than a 0 that
# happened to mean the right thing.
#
# Nothing serialises these. A merges file records the model, not the caller's
# truncation policy, so there is no on-disk representation to preserve and the
# integers they replaced were never written anywhere.
enum Trunc { TruncRight, TruncLeft, TruncLongestFirst }

# Keep the first `keep` tokens.
#
# Right truncation is the default everywhere and it is a real modelling choice
# rather than a neutral one: it keeps the beginning of a document, which for a
# news article is the part that says what the article is about and for a chat
# transcript is the part that is least relevant. Left truncation exists for the
# second case.
fn truncate_right(e: Encoding, keep: I64) -> Encoding {
  let out: Encoding = new_encoding()
  let i: I64 = 0
  while i < length(e) and i < keep {
    copy_token(out, e, i)
    i = i + 1
  }
  out
}

# The single-sequence truncation a strategy implies.
#
# The one exhaustive `match` on `Trunc` in the file, so adding a fourth strategy
# reports here and nowhere else. It used to be four copies of
# `if strategy == TRUNC_LEFT { left } else { right }`, two in `build_single` and
# two in `build_pair`, and a fourth strategy would have taken the `else` in all
# four silently.
#
# Longest-first degrades to right truncation, which is what the old `else` did.
# It is written out rather than swept under a `_` because it is a real decision:
# longest-first balances two sequences against each other and there is only one
# sequence here, so there is nothing for it to balance.
fn truncate_one(e: Encoding, keep: I64, strategy: Trunc) -> Encoding {
  match strategy {
    TruncLeft => truncate_left(e, keep),
    TruncRight => truncate_right(e, keep),
    TruncLongestFirst => truncate_right(e, keep),
  }
}

fn truncate_left(e: Encoding, keep: I64) -> Encoding {
  let out: Encoding = new_encoding()
  let from: I64 = length(e) - keep
  if from < 0 {
    from = 0
  }
  let i: I64 = from
  while i < length(e) {
    copy_token(out, e, i)
    i = i + 1
  }
  out
}

# Truncate a pair so that the total is `budget`, taking from whichever is
# currently longer, one token at a time.
#
# One at a time, and not proportionally. Proportional truncation cuts a
# three-token question by the same fraction as a four-hundred-token passage,
# which destroys the question to save two tokens of the passage. Longest-first
# converges to equal lengths and only shortens the shorter sequence once the
# longer one has been cut down to meet it, which is the behaviour anyone pairing
# a query with a document wants.
#
# The budget passed in is already net of the specials' own tokens; see
# `build_pair`.
fn truncate_longest_first(a: Encoding, b: Encoding, budget: I64,
                          out_a: Encoding, out_b: Encoding) {
  let la: I64 = length(a)
  let lb: I64 = length(b)
  while la + lb > budget and la + lb > 0 {
    if la >= lb {
      la = la - 1
    } else {
      lb = lb - 1
    }
  }
  if la < 0 { la = 0 }
  if lb < 0 { lb = 0 }
  let ta: Encoding = truncate_right(a, la)
  let tb: Encoding = truncate_right(b, lb)
  out_a.ids = ta.ids
  out_a.tokens = ta.tokens
  out_a.mask = ta.mask
  out_a.type_ids = ta.type_ids
  out_a.starts = ta.starts
  out_a.ends = ta.ends
  out_a.special = ta.special
  out_b.ids = tb.ids
  out_b.tokens = tb.tokens
  out_b.mask = tb.mask
  out_b.type_ids = tb.type_ids
  out_b.starts = tb.starts
  out_b.ends = tb.ends
  out_b.special = tb.special
}

# ---- assembling -------------------------------------------------------------

fn add_special(e: Encoding, id: Opt[I64], tok: Str, type_id: I64) {
  match id {
    # Empty span. See the header.
    Some(x) => push_token(e, x, tok, 1, type_id, -1, -1, true),
    None => unit,
  }
}

# `[CLS] tokens [SEP]`, truncated to `max_len` including the specials.
#
# `max_len` of 0 means no limit. The order is truncate, then wrap: wrapping
# first and truncating after would cut the trailing `[SEP]` off every sequence
# that hit the limit, and a model trained with a separator and fed sequences
# without one degrades in a way that looks like a data problem.
fn build_single(n: normalize.Norm, p: pieces.Pieces, v: vocab.Vocab,
                sp: Specials, max_len: I64, strategy: Trunc) -> Encoding {
  let body: Encoding = from_pieces(n, p, v, 0)
  if max_len > 0 {
    let budget: I64 = max_len - overhead_single(sp)
    if budget < 0 {
      budget = 0
    }
    body = truncate_one(body, budget, strategy)
  }
  let out: Encoding = new_encoding()
  add_special(out, sp.cls_id, sp.cls, 0)
  let i: I64 = 0
  while i < length(body) {
    copy_token(out, body, i)
    i = i + 1
  }
  add_special(out, sp.sep_id, sp.sep, 0)
  out
}

# `[CLS] a [SEP] b [SEP]`, with type ids 0 and 1.
#
# The second sequence's type id covers its trailing separator, which is the BERT
# convention: the separator belongs to the segment it closes. Getting this wrong
# shifts one position of the segment embedding and is invisible in every metric
# except the one the pair task is measured by.
fn build_pair(na: normalize.Norm, pa: pieces.Pieces,
              nb: normalize.Norm, pb: pieces.Pieces,
              v: vocab.Vocab, sp: Specials, max_len: I64, strategy: Trunc) -> Encoding {
  let a: Encoding = from_pieces(na, pa, v, 0)
  let b: Encoding = from_pieces(nb, pb, v, 1)
  if max_len > 0 {
    let budget: I64 = max_len - overhead_pair(sp)
    if budget < 0 {
      budget = 0
    }
    if strategy == TruncLongestFirst {
      let ta: Encoding = new_encoding()
      let tb: Encoding = new_encoding()
      truncate_longest_first(a, b, budget, ta, tb)
      a = ta
      b = tb
    } else {
      # Right or left applied to the pair means applied to the second sequence
      # first, then the first if that was not enough. The second sequence is the
      # passage in every pair task skein has been used for, and cutting the
      # query is a last resort.
      let keep_b: I64 = budget - length(a)
      if keep_b < 0 {
        keep_b = 0
      }
      b = truncate_one(b, keep_b, strategy)
      let keep_a: I64 = budget - length(b)
      if keep_a < 0 {
        keep_a = 0
      }
      a = truncate_one(a, keep_a, strategy)
    }
  }
  let out: Encoding = new_encoding()
  add_special(out, sp.cls_id, sp.cls, 0)
  let i: I64 = 0
  while i < length(a) {
    copy_token(out, a, i)
    i = i + 1
  }
  add_special(out, sp.sep_id, sp.sep, 0)
  i = 0
  while i < length(b) {
    copy_token(out, b, i)
    i = i + 1
  }
  add_special(out, sp.sep_id, sp.sep, 1)
  out
}

# ---- padding -----------------------------------------------------------------

enum Pad { PadRight, PadLeft }

# Pad to `width`, or leave alone if already at or over it.
#
# Over it is left alone rather than truncated, because padding and truncation
# are separate decisions with separate parameters and a function that silently
# did both would make a max length that was never configured take effect.
#
# The padded positions get mask 0, type id 0, an empty span and `special` true.
# Mask 0 is the only one of those the model sees, and it is the reason padding
# is safe at all: attention over a masked position contributes nothing, so a
# batch of unequal lengths gives the same result as running each row alone. A
# padding token with mask 1 is the single most expensive one-character bug in
# this area, because the model trains happily and learns to predict `[PAD]`.
fn pad_to(e: Encoding, width: I64, sp: Specials, side: Pad) -> Res[Unit, Str] {
  let pad_id: I64 = match sp.pad_id {
    Some(id) => id,
    None => return Err("encoding.pad_to: no padding token is configured, and padding with an arbitrary id would insert a real word"),
  }
  let need: I64 = width - length(e)
  if need <= 0 {
    # Already at least this wide: nothing to do, and that is a success. Under
    # the old convention this was `return ""`, which is the same bytes as the
    # success at the bottom of the function and told a reader nothing about
    # which it was.
    return Ok(unit)
  }
  match side {
    PadLeft => pad_left_in_place(e, need, pad_id, sp.pad),
    PadRight => pad_right_in_place(e, need, pad_id, sp.pad),
  }
  Ok(unit)
}

# Left padding rebuilds the encoding, because the pads go in front and the
# parallel arrays have no prepend. Right padding appends in place, which is why
# the two are not one function with a flag.
fn pad_left_in_place(e: Encoding, need: I64, pad_id: I64, pad: Str) {
  let out: Encoding = new_encoding()
  let k: I64 = 0
  while k < need {
    push_token(out, pad_id, pad, 0, 0, -1, -1, true)
    k = k + 1
  }
  let i: I64 = 0
  while i < length(e) {
    copy_token(out, e, i)
    i = i + 1
  }
  e.ids = out.ids
  e.tokens = out.tokens
  e.mask = out.mask
  e.type_ids = out.type_ids
  e.starts = out.starts
  e.ends = out.ends
  e.special = out.special
}

fn pad_right_in_place(e: Encoding, need: I64, pad_id: I64, pad: Str) {
  let k: I64 = 0
  while k < need {
    push_token(e, pad_id, pad, 0, 0, -1, -1, true)
    k = k + 1
  }
}

# ---- batches -----------------------------------------------------------------

struct Batch {
  items: Arr[Encoding],
}

fn new_batch() -> Batch {
  let a: Arr[Encoding] = []
  Batch { items: a }
}

fn batch_add(b: Batch, e: Encoding) {
  push(b.items, e)
}

fn batch_size(b: Batch) -> I64 = len(b.items)

fn longest(b: Batch) -> I64 {
  let m: I64 = 0
  let i: I64 = 0
  while i < len(b.items) {
    if length(b.items[i]) > m {
      m = length(b.items[i])
    }
    i = i + 1
  }
  m
}

# Pad every row to the longest row in the batch.
#
# The point of padding to the longest rather than to a fixed model maximum: a
# batch of 32 tweets padded to 512 is 15 times the arithmetic for the same
# result. Bucketing by length before batching makes this much better still, and
# that is `src/sequence.tw`.
fn pad_batch_longest(b: Batch, sp: Specials, side: Pad) -> Res[Unit, Str] {
  let w: I64 = longest(b)
  let i: I64 = 0
  while i < len(b.items) {
    pad_to(b.items[i], w, sp, side)?
    i = i + 1
  }
  Ok(unit)
}

fn pad_batch_fixed(b: Batch, width: I64, sp: Specials, side: Pad) -> Res[Unit, Str] {
  let i: I64 = 0
  while i < len(b.items) {
    pad_to(b.items[i], width, sp, side)?
    i = i + 1
  }
  Ok(unit)
}

# How many padding positions the batch carries, and how many real ones.
#
# A ratio worth printing once at the start of a run. Anything above about 30%
# means the batching is wrong, not the model, and it is the cheapest speedup
# available in most pipelines.
fn pad_waste(b: Batch) -> I64 {
  let waste: I64 = 0
  let i: I64 = 0
  while i < len(b.items) {
    let e: Encoding = b.items[i]
    let k: I64 = 0
    while k < length(e) {
      if e.mask[k] == 0 {
        waste = waste + 1
      }
      k = k + 1
    }
    i = i + 1
  }
  waste
}

# ---- reading back ------------------------------------------------------------

# The source substring a token came from, or the empty string for a token with
# no source.
#
# This is what the offset map is for, and it is one line, which is the point:
# every consumer of an offset should be able to write this and get it right.
fn source_text(e: Encoding, i: I64, source: Str) -> Str {
  if i < 0 or i >= length(e) or e.starts[i] < 0 {
    return ""
  }
  text.slice(source, e.starts[i], e.ends[i])
}

# The source span covering tokens `a` through `b`, ignoring specials.
#
# Used to answer "which characters does this predicted span correspond to",
# which is the question a span-extraction model's output poses. Specials are
# skipped rather than treated as zero-width at 0, which is the whole reason
# their span is -1.
fn source_span(e: Encoding, a: I64, b: I64) -> normalize.Span {
  # `Opt` rather than a `lo` and a `hi` both starting at -1. Those were two
  # correlated locals, and only `lo` was ever tested for the sentinel: `hi`
  # relied on every real end being greater than -1, which is true and is not
  # something the code said. One `Opt` covers both, and "no token in this range
  # had a source" is the `None` at the end rather than a comparison.
  let found: Opt[normalize.Span] = None
  let i: I64 = a
  while i <= b and i < length(e) {
    if i >= 0 and e.starts[i] >= 0 {
      found = widen_span(found, e.starts[i], e.ends[i])
    }
    i = i + 1
  }
  match found {
    Some(sp) => sp,
    None => normalize.empty_span(),
  }
}

# The span grown to cover [lo, hi), or that span when there was nothing yet.
fn widen_span(cur: Opt[normalize.Span], lo: I64, hi: I64) -> Opt[normalize.Span] {
  match cur {
    None => Some(normalize.span(lo, hi)),
    Some(sp) => Some(normalize.span(
      if lo < sp.start { lo } else { sp.start },
      if hi > sp.end { hi } else { sp.end })),
  }
}
