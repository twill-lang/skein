mode systems

import "harness.tw" as t
import "../src/encoding.tw" as enc
import "../src/normalize.tw" as nm
import "../src/vocab.tw" as vb
import "../src/pieces.tw" as pc
import "../src/pretok.tw" as pt
import "../src/simple.tw" as sp

fn fixture_vocab(words: Arr[Str]) -> vb.Vocab {
  let v: vb.Vocab = vb.new_vocab()
  let r: Arr[Str] = ["[PAD]", "[UNK]", "[CLS]", "[SEP]", "[MASK]"]
  vb.add_reserved(v, r, "[UNK]")
  let i: I64 = 0
  while i < len(words) {
    vb.add(v, words[i])
    i = i + 1
  }
  v
}

fn fixture_specials(v: vb.Vocab) -> enc.Specials {
  let s: enc.Specials = enc.no_specials()
  enc.specials_from(v, "[CLS]", "[SEP]", "[PAD]", "[UNK]", "[MASK]", s)
  s
}

# The headline test. The source has a capital and a run of spaces; the
# normalised string does not. Every token's offset must point into the source.
fn an_offset_points_into_the_source_and_not_the_normalised_string() {
  let src: Str = "Hello   World"
  let n: nm.Norm = nm.blank()
  nm.apply(nm.spec_default(), src, n)
  let v: vb.Vocab = fixture_vocab(["hello", "world"])
  let p: pc.Pieces = sp.whitespace(n.text, pt.whitespace(n.text))
  let e: enc.Encoding = enc.from_pieces(n, p, v, 0)
  t.equal_i64("two tokens", enc.length(e), 2)
  t.equal_str("the first token's source text", enc.source_text(e, 0, src), "Hello")
  t.equal_str("the second token's source text", enc.source_text(e, 1, src), "World")
  t.equal_i64("and the second starts at 8, not 6", e.starts[1], 8)
}

fn a_special_token_has_an_empty_span_and_not_a_zero_width_one() {
  let src: Str = "hello"
  let n: nm.Norm = nm.blank()
  nm.apply(nm.spec_default(), src, n)
  let v: vb.Vocab = fixture_vocab(["hello"])
  let s: enc.Specials = fixture_specials(v)
  let p: pc.Pieces = sp.whitespace(n.text, pt.whitespace(n.text))
  let e: enc.Encoding = enc.build_single(n, p, v, s, 0, enc.TRUNC_RIGHT)
  t.equal_i64("three tokens", enc.length(e), 3)
  t.equal_str("the first is CLS", e.tokens[0], "[CLS]")
  t.equal_i64("its start is -1", e.starts[0], -1)
  t.equal_i64("its end is -1", e.ends[0], -1)
  t.check("and it is marked special", e.special[0])
  t.equal_str("mapping it to source text gives nothing",
              enc.source_text(e, 0, src), "")
  t.equal_str("the last is SEP", e.tokens[2], "[SEP]")
  t.equal_i64("with an empty span too", e.starts[2], -1)
}

fn truncation_leaves_room_for_the_special_tokens() {
  let src: Str = "a b c d e"
  let n: nm.Norm = nm.blank()
  nm.apply(nm.spec_default(), src, n)
  let v: vb.Vocab = fixture_vocab(["a", "b", "c", "d", "e"])
  let s: enc.Specials = fixture_specials(v)
  let p: pc.Pieces = sp.whitespace(n.text, pt.whitespace(n.text))
  let e: enc.Encoding = enc.build_single(n, p, v, s, 4, enc.TRUNC_RIGHT)
  t.equal_i64("exactly four tokens", enc.length(e), 4)
  t.equal_str("CLS first", e.tokens[0], "[CLS]")
  t.equal_str("two body tokens", e.tokens[1], "a")
  t.equal_str("the second", e.tokens[2], "b")
  t.equal_str("SEP last, and it survived the truncation", e.tokens[3], "[SEP]")
}

fn left_truncation_keeps_the_end_of_the_sequence() {
  let src: Str = "a b c d e"
  let n: nm.Norm = nm.blank()
  nm.apply(nm.spec_default(), src, n)
  let v: vb.Vocab = fixture_vocab(["a", "b", "c", "d", "e"])
  let s: enc.Specials = fixture_specials(v)
  let p: pc.Pieces = sp.whitespace(n.text, pt.whitespace(n.text))
  let e: enc.Encoding = enc.build_single(n, p, v, s, 4, enc.TRUNC_LEFT)
  t.equal_str("the last two body tokens survived", e.tokens[1], "d")
  t.equal_str("and the very last", e.tokens[2], "e")
}

fn a_truncated_token_keeps_its_own_offset() {
  let src: Str = "aa bb cc"
  let n: nm.Norm = nm.blank()
  nm.apply(nm.spec_default(), src, n)
  let v: vb.Vocab = fixture_vocab(["aa", "bb", "cc"])
  let s: enc.Specials = fixture_specials(v)
  let p: pc.Pieces = sp.whitespace(n.text, pt.whitespace(n.text))
  let e: enc.Encoding = enc.build_single(n, p, v, s, 4, enc.TRUNC_LEFT)
  t.equal_str("the surviving tokens still map to their own source text",
              enc.source_text(e, 2, src), "cc")
  t.equal_i64("cc is at source byte 6", e.starts[2], 6)
}

fn a_pair_gets_two_type_ids_and_three_specials() {
  let v: vb.Vocab = fixture_vocab(["q", "p"])
  let s: enc.Specials = fixture_specials(v)
  let na: nm.Norm = nm.blank()
  let nb: nm.Norm = nm.blank()
  nm.apply(nm.spec_default(), "q", na)
  nm.apply(nm.spec_default(), "p", nb)
  let pa: pc.Pieces = sp.whitespace(na.text, pt.whitespace(na.text))
  let pb: pc.Pieces = sp.whitespace(nb.text, pt.whitespace(nb.text))
  let e: enc.Encoding = enc.build_pair(na, pa, nb, pb, v, s, 0, enc.TRUNC_LONGEST_FIRST)
  t.equal_i64("CLS q SEP p SEP", enc.length(e), 5)
  t.equal_i64("CLS is segment 0", e.type_ids[0], 0)
  t.equal_i64("q is segment 0", e.type_ids[1], 0)
  t.equal_i64("the first SEP is segment 0", e.type_ids[2], 0)
  t.equal_i64("p is segment 1", e.type_ids[3], 1)
  t.equal_i64("the closing SEP belongs to segment 1", e.type_ids[4], 1)
}

fn longest_first_truncation_takes_from_the_longer_sequence() {
  let v: vb.Vocab = fixture_vocab(["a", "b", "c", "d", "e", "q"])
  let s: enc.Specials = fixture_specials(v)
  let na: nm.Norm = nm.blank()
  let nb: nm.Norm = nm.blank()
  nm.apply(nm.spec_default(), "q", na)
  nm.apply(nm.spec_default(), "a b c d e", nb)
  let pa: pc.Pieces = sp.whitespace(na.text, pt.whitespace(na.text))
  let pb: pc.Pieces = sp.whitespace(nb.text, pt.whitespace(nb.text))
  # Budget is 7 minus three specials, so four body tokens.
  let e: enc.Encoding = enc.build_pair(na, pa, nb, pb, v, s, 7, enc.TRUNC_LONGEST_FIRST)
  t.equal_i64("seven tokens", enc.length(e), 7)
  t.equal_str("the one-token query survived whole", e.tokens[1], "q")
  t.equal_str("and the passage lost its tail", e.tokens[3], "a")
  t.equal_str("keeping three of five", e.tokens[5], "c")
}

fn padding_marks_the_padded_positions_with_a_zero_mask() {
  let v: vb.Vocab = fixture_vocab(["a"])
  let s: enc.Specials = fixture_specials(v)
  let n: nm.Norm = nm.blank()
  nm.apply(nm.spec_default(), "a", n)
  let p: pc.Pieces = sp.whitespace(n.text, pt.whitespace(n.text))
  let e: enc.Encoding = enc.build_single(n, p, v, s, 0, enc.TRUNC_RIGHT)
  let err: Str = enc.pad_to(e, 5, s, enc.PAD_RIGHT)
  t.equal_str("padding succeeded", err, "")
  t.equal_i64("five long", enc.length(e), 5)
  t.equal_i64("the real tokens are masked in", e.mask[0], 1)
  t.equal_i64("and the padding is masked out", e.mask[4], 0)
  t.equal_i64("padding uses the PAD id", e.ids[4], vb.id_of(v, "[PAD]"))
  t.equal_i64("and carries an empty span", e.starts[4], -1)
}

fn left_padding_puts_the_padding_first() {
  let v: vb.Vocab = fixture_vocab(["a"])
  let s: enc.Specials = fixture_specials(v)
  let n: nm.Norm = nm.blank()
  nm.apply(nm.spec_default(), "a", n)
  let p: pc.Pieces = sp.whitespace(n.text, pt.whitespace(n.text))
  let e: enc.Encoding = enc.build_single(n, p, v, s, 0, enc.TRUNC_RIGHT)
  enc.pad_to(e, 5, s, enc.PAD_LEFT)
  t.equal_i64("five long", enc.length(e), 5)
  t.equal_i64("the first position is padding", e.mask[0], 0)
  t.equal_i64("the last is real", e.mask[4], 1)
  t.equal_str("and the last is still SEP", e.tokens[4], "[SEP]")
}

fn padding_without_a_pad_token_is_refused() {
  let v: vb.Vocab = fixture_vocab(["a"])
  let s: enc.Specials = enc.no_specials()
  enc.specials_from(v, "[CLS]", "[SEP]", "", "[UNK]", "", s)
  let e: enc.Encoding = enc.new_encoding()
  enc.push_token(e, 5, "a", 1, 0, 0, 1, false)
  t.check("it returns a message rather than padding with id 0",
          len(enc.pad_to(e, 4, s, enc.PAD_RIGHT)) > 0)
}

fn padding_an_already_long_enough_encoding_does_nothing() {
  let v: vb.Vocab = fixture_vocab(["a"])
  let s: enc.Specials = fixture_specials(v)
  let e: enc.Encoding = enc.new_encoding()
  enc.push_token(e, 5, "a", 1, 0, 0, 1, false)
  enc.pad_to(e, 1, s, enc.PAD_RIGHT)
  t.equal_i64("still one token", enc.length(e), 1)
}

fn a_batch_pads_to_its_own_longest_row() {
  let v: vb.Vocab = fixture_vocab(["a", "b", "c"])
  let s: enc.Specials = fixture_specials(v)
  let b: enc.Batch = enc.new_batch()
  let one: enc.Encoding = enc.new_encoding()
  enc.push_token(one, 5, "a", 1, 0, 0, 1, false)
  let two: enc.Encoding = enc.new_encoding()
  enc.push_token(two, 6, "b", 1, 0, 0, 1, false)
  enc.push_token(two, 7, "c", 1, 0, 2, 3, false)
  enc.batch_add(b, one)
  enc.batch_add(b, two)
  t.equal_i64("the longest row is two", enc.longest(b), 2)
  t.equal_str("padding succeeded", enc.pad_batch_longest(b, s, enc.PAD_RIGHT), "")
  t.equal_i64("the short row grew", enc.length(b.items[0]), 2)
  t.equal_i64("one wasted position", enc.pad_waste(b), 1)
}

fn a_special_token_that_is_not_in_the_vocabulary_is_refused() {
  let v: vb.Vocab = fixture_vocab(["a"])
  let s: enc.Specials = enc.no_specials()
  t.check("it names the token",
          len(enc.specials_from(v, "[NOPE]", "[SEP]", "[PAD]", "[UNK]", "", s)) > 0)
}

fn an_empty_special_name_means_the_model_does_not_have_one() {
  let v: vb.Vocab = fixture_vocab(["a"])
  let s: enc.Specials = enc.no_specials()
  t.equal_str("no error", enc.specials_from(v, "", "", "[PAD]", "[UNK]", "", s), "")
  t.equal_i64("CLS is unconfigured", s.cls_id, -1)
  t.equal_i64("and contributes no overhead", enc.overhead_single(s), 0)
}

fn the_overhead_counts_wrapping_tokens_and_not_replacements() {
  let v: vb.Vocab = fixture_vocab(["a"])
  let s: enc.Specials = fixture_specials(v)
  t.equal_i64("CLS and SEP", enc.overhead_single(s), 2)
  t.equal_i64("CLS and two SEP", enc.overhead_pair(s), 3)
}

fn an_extra_special_is_recognised() {
  let v: vb.Vocab = fixture_vocab(["<lang:en>"])
  let s: enc.Specials = fixture_specials(v)
  t.equal_str("registering succeeded", enc.register_extra(s, v, "<lang:en>"), "")
  t.check("and it is special now", enc.is_special_id(s, vb.id_of(v, "<lang:en>")))
  t.check("a plain id is not", not enc.is_special_id(s, 99))
}

fn a_source_span_over_a_range_skips_the_specials() {
  let src: Str = "aa bb"
  let n: nm.Norm = nm.blank()
  nm.apply(nm.spec_default(), src, n)
  let v: vb.Vocab = fixture_vocab(["aa", "bb"])
  let s: enc.Specials = fixture_specials(v)
  let p: pc.Pieces = sp.whitespace(n.text, pt.whitespace(n.text))
  let e: enc.Encoding = enc.build_single(n, p, v, s, 0, enc.TRUNC_RIGHT)
  let got: nm.Span = enc.source_span(e, 0, enc.length(e) - 1)
  t.equal_i64("the span starts at the first real token", got.start, 0)
  t.equal_i64("and ends at the last real one", got.end, 5)
}

fn a_span_over_specials_alone_is_empty() {
  let v: vb.Vocab = fixture_vocab(["a"])
  let s: enc.Specials = fixture_specials(v)
  let e: enc.Encoding = enc.new_encoding()
  enc.add_special(e, s.cls_id, s.cls, 0)
  let got: nm.Span = enc.source_span(e, 0, 0)
  t.check("empty", nm.span_is_empty(got))
}

fn trimming_a_leading_space_moves_the_start_by_one() {
  let src: Str = "a bb"
  let e: enc.Encoding = enc.new_encoding()
  enc.push_token(e, 5, " bb", 1, 0, 1, 4, false)
  enc.trim_leading_space(e, src)
  t.equal_i64("the start moved past the space", e.starts[0], 2)
  t.equal_str("and the span is now the word", enc.source_text(e, 0, src), "bb")
}

fn the_parallel_arrays_stay_the_same_length() {
  let e: enc.Encoding = enc.new_encoding()
  enc.push_token(e, 1, "a", 1, 0, 0, 1, false)
  enc.push_token(e, 2, "b", 1, 0, 1, 2, false)
  t.equal_str("the shape holds", enc.assert_shape(e), "")
}

an_offset_points_into_the_source_and_not_the_normalised_string()
a_special_token_has_an_empty_span_and_not_a_zero_width_one()
truncation_leaves_room_for_the_special_tokens()
left_truncation_keeps_the_end_of_the_sequence()
a_truncated_token_keeps_its_own_offset()
a_pair_gets_two_type_ids_and_three_specials()
longest_first_truncation_takes_from_the_longer_sequence()
padding_marks_the_padded_positions_with_a_zero_mask()
left_padding_puts_the_padding_first()
padding_without_a_pad_token_is_refused()
padding_an_already_long_enough_encoding_does_nothing()
a_batch_pads_to_its_own_longest_row()
a_special_token_that_is_not_in_the_vocabulary_is_refused()
an_empty_special_name_means_the_model_does_not_have_one()
the_overhead_counts_wrapping_tokens_and_not_replacements()
an_extra_special_is_recognised()
a_source_span_over_a_range_skips_the_specials()
a_span_over_specials_alone_is_empty()
trimming_a_leading_space_moves_the_start_by_one()
the_parallel_arrays_stay_the_same_length()
t.report("skein encoding")
