mode systems

# What is left of the test harness once the assertions are twill 1.11's
# `std/test`: one formatter, so a suite can compare an `Opt[I64]` through
# `t.equal_str` and see both sides when it fails.
#
# Deliberately nothing in here imports `std/test`. Every import of a module is
# its own instance, so a helper here that called `t.equal_str` would count into
# a counter no suite's `t.report` ever reads, and a failure it recorded would
# leave the file green. That was measured, not guessed: a two-line probe did
# exactly that and reported `0 passed, 0 failed` and `ok`. The suites that need
# `equal_opt_i64` define it locally, three lines each, on top of this.

fn opt_str(o: Opt[I64]) -> Str {
  match o {
    Some(v) => "Some(" + str(v) + ")",
    None => "None",
  }
}
